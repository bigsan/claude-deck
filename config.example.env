# Claude Deck configuration, for the herdr plugin and standalone alike:
#   cp config.example.env "$(herdr plugin config-dir bigsan.claude-deck)/config.env"
# Every key can also be set as an environment variable with a DECK_ prefix,
# e.g. DECK_LOG_LEVEL=debug.

# off, error, warn, info, debug or trace
LOG_LEVEL=warn

# where the log goes; default ~/.local/state/claude-deck/claude-deck.log
LOG_FILE=

# 1 lets the mouse scroll, click and double-click; 0 leaves it to the terminal, to drag-select text
MOUSE=1

# images kept in the terminal, so going back to one does not send it again
IMAGE_CACHE=8

# agent statuses that open the deck, comma-separated
OPEN_ON=

# statuses that close it again
CLOSE_ON=

# right or down
DIRECTION=right

# the share of the split the deck takes
RATIO=0.40

# 1 moves the focus to the deck when it opens, 0 keeps it on the agent
FOCUS=1

# the view it opens in: A tabs, B columns, C timeline
VIEW=A

# the Claude temp root; default /tmp/claude-<uid>
SCRATCHPAD_ROOT=
